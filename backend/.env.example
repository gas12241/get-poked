# Django
SECRET_KEY=
DEBUG=True

# Database (PostgreSQL)
DB_NAME=get_poked
DB_USER=get_poked
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# CORS — comma-separated list of allowed frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Pokémon TCG API key — required for sync (20,000 req/day vs. 1,000 unauthenticated).
# Get one at https://dev.pokemontcg.io/. Never commit the real value.
POKEMON_TCG_API_KEY=

# The frontend's own origin — used to build links sent by email (e.g. the
# email-verification link). Distinct from CORS_ALLOWED_ORIGINS above.
FRONTEND_URL=http://localhost:5173

# "From" address on registration/verification emails. In dev, EMAIL_BACKEND
# defaults to the console backend, so emails print here instead of sending.
DEFAULT_FROM_EMAIL=noreply@getpoked.local
