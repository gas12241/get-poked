# Django
SECRET_KEY=
DEBUG=True

# Database (PostgreSQL)
DB_NAME=get_poked
DB_USER=get_poked
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# CORS — comma-separated list of allowed frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Pokémon TCG API key — required for sync (20,000 req/day vs. 1,000 unauthenticated).
